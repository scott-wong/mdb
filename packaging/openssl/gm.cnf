# RFC 8998 national-cryptography TLS 1.3 profile. This is intentionally not
# TLCP/NTLS: one SM2 certificate, TLS 1.3 only, SM2 key exchange and signature,
# SM4-GCM record protection and SM3 transcript hashing.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1.3
MaxProtocol = TLSv1.3
Ciphersuites = TLS_SM4_GCM_SM3
Groups = SM2
SignatureAlgorithms = sm2sig_sm3
Enable_sm_tls13_strict = on
